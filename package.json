    "test:v2": "vitest run tests/v2",
    "sync:v2": "node scripts/sync-v2-architecture.mjs",
    "test:v2:browser": "node scripts/test-v2-browser.mjs",
    "test:v2:adventure": "node scripts/test-v2-adventure-browser.mjs",
    "test:v2:mods": "node scripts/test-v2-mods-browser.mjs",
    "test:v2:nest": "node scripts/test-v2-nest-browser.mjs",
    "test:v2:equipment": "node scripts/test-v2-equipment-browser.mjs",
    "test:v2:builds": "node scripts/test-v2-builds-browser.mjs",
    "test:v2:factions": "node scripts/test-v2-factions-browser.mjs",
    "test:v2:difficulty": "node scripts/test-v2-difficulty-browser.mjs",
    "test:v2:max20": "node scripts/test-v2-max20-browser.mjs",
    "replay:v2": "node scripts/replay-v2.mjs",
    "test:v2:api": "node scripts/test-v2-api-browser.mjs",
    "test:v2:expedition": "node scripts/test-v2-expedition-browser.mjs",
    "test:v2:escort": "node scripts/test-v2-escort-browser.mjs",
    "bench:v2:expedition": "node scripts/bench-v2-expedition.mjs",
    "test:v2:tutorial": "node scripts/test-v2-tutorial-browser.mjs",
    "test:v2:mod-adventure": "node scripts/test-v2-mod-adventure-browser.mjs",
    "test:v2:interface": "node scripts/test-v2-interface-browser.mjs",
    "prepare:audio": "node scripts/prepare-v2-audio.mjs",
    "predev": "npm run prepare:audio",
    "prebuild": "npm run prepare:audio",
    "prepreview": "npm run prepare:audio",
    "test:v2:characters": "node scripts/test-v2-characters-browser.mjs",
    "test:v2:audio": "node scripts/prepare-v2-audio.mjs && node scripts/test-v2-audio-browser.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "typescript": "5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
